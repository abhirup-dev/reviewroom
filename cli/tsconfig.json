{
  // The CLI runs on Node: Node types, no DOM. Bun bundles it (scripts/build.mjs), so this only type-checks.
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023"], "types": ["node"], "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true
  },
  "include": ["."],
  "exclude": ["**/*.test.*"]
}
