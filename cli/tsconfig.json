{
  // The CLI runs on Node: Node types, no DOM. Bun bundles it (scripts/build.ts), so this only type-checks.
  "extends": "../tsconfig.base.json",
  "compilerOptions": { "lib": ["ES2023"], "types": ["node"], "erasableSyntaxOnly": true, "allowImportingTsExtensions": true },
  "include": ["."],
  "exclude": ["**/*.test.*"]
}
