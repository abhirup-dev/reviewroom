{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/hub/index.ts",
    "cli/reviewroom.ts",
    "scripts/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "cli/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignoreDependencies": [
    "@ast-grep/cli",
    "@fontsource-variable/.+"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "pgrep",
    "osascript"
  ]
}
