{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "cli/reviewroom.ts",
    "scripts/*.{mjs,ts}"
  ],
  "project": [
    "src/**/*.ts",
    "cli/**/*.ts",
    "scripts/**/*.{ts,mjs}"
  ],
  "ignoreDependencies": [
    "@fontsource-variable/.+",
    "emoji-picker-element-data"
  ],
  "ignoreExportsUsedInFile": true
}
