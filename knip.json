{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/hub/index.ts",
    "cli/reviewroom.ts",
    "scripts/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "cli/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignoreDependencies": [
    "@fontsource-variable/.+",
    "emoji-picker-element-data"
  ],
  "ignoreExportsUsedInFile": true
}
