{
  "name": "reviewroom",
  "version": "0.1.0",
  "description": "Agent-driven code review workbench: freeform narrative + live diffs (@pierre/diffs) + dockable panels + round-based threads.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "reviewroom": "./dist/cli/reviewroom.js"
  },
  "exports": {
    ".": "./dist/reviewroom.js",
    "./style.css": "./dist/reviewroom.css",
    "./schema/state.json": "./schema/state.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cli",
    "schema",
    "templates",
    "skills",
    "README.md"
  ],
  "scripts": {
    "setup": "bun install --frozen-lockfile && bun run build && bun link && bun scripts/app-install.ts",
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cli && tsc --noEmit -p scripts",
    "lint": "oxlint --type-aware --deny-warnings && knip && jscpd && bun scripts/ascii.ts",
    "test": "bun test ./src ./cli",
    "smoke": "bun run build && bun test ./e2e --timeout 30000",
    "check": "bun run typecheck && bun run lint && bun run test && bun run smoke",
    "schema": "bun scripts/schema.ts",
    "demo": "bun run build && bash examples/make-demo-repo.sh .demo/mfas && bun dist/cli/reviewroom.js pr feat/habit-events --repo .demo/mfas --dir examples/habit-events",
    "demo-page": "bun run build && bash examples/make-demo-repo.sh .demo/mfas && bun scripts/build-demo.ts .demo/mfas main feat/habit-events examples/habit-events .demo/reviewroom-demo.html",
    "app": "cd app && tauri dev",
    "app-build": "cd app && tauri build",
    "prepack": "bun scripts/build.ts",
    "app-install": "bun scripts/app-install.ts"
  },
  "engines": {
    "bun": ">=1.3.12"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/view": "^6.43.14",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@hono/bun": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@octokit/core": "^7.0.8",
    "@octokit/graphql-schema": "^15.26.1",
    "@octokit/plugin-paginate-graphql": "^6.0.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@pierre/diffs": "^1.5.2",
    "@tauri-apps/cli": "^2.12.3",
    "@types/bun": "^1.4.3",
    "@types/jsdom": "^30.0.0",
    "cac": "^7.1.0",
    "dockview": "^8.5.1",
    "dompurify": "^3.4.16",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "fuzzysort": "^4.0.2",
    "hono": "^4.13.13",
    "jscpd": "^5.4.1",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "marked": "^18.1.0",
    "marked-emoji": "^3.0.0",
    "open": "^11.0.4",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "xstate": "^5.33.2",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.2"
}
