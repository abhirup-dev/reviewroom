{
  "name": "readingroom",
  "version": "0.1.0",
  "description": "Agent-driven code review workbench: freeform narrative + live diffs (@pierre/diffs) + dockable panels + round-based threads.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "readingroom": "./cli/readingroom.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/readingroom.js"
    },
    "./style.css": "./dist/readingroom.css",
    "./schema/state.json": "./schema/state.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cli",
    "schema",
    "skill",
    "templates",
    "AGENTS.md",
    "README.md",
    "examples",
    "scripts"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "demo": "node cli/readingroom.mjs serve examples/habit-events",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "dockview-core": "^8.4.1",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@types/node": "^22"
  }
}
