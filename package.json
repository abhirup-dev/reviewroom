{
  "name": "reviewroom",
  "version": "0.1.0",
  "description": "Agent-driven code review workbench: freeform narrative + live diffs (@pierre/diffs) + dockable panels + round-based threads.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "reviewroom": "./dist/cli/reviewroom.mjs"
  },
  "exports": {
    ".": "./dist/reviewroom.js",
    "./style.css": "./dist/reviewroom.css",
    "./schema/state.json": "./schema/state.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cli",
    "schema",
    "templates",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "dev": "bun scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cli",
    "test": "bun test",
    "smoke": "bun scripts/smoke.mjs",
    "schema": "bun scripts/schema.ts",
    "prepack": "bun scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@pierre/diffs": "^1.5.2",
    "@types/node": "^22",
    "cac": "^7.1.0",
    "dockview-core": "^8.4.1",
    "dompurify": "^3.4.16",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "marked": "^18.1.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.2"
}
