{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true,
    "noImplicitAny": true, "noEmit": true,
    "isolatedModules": true, "useDefineForClassFields": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
