{
  // Build and test scripts run on Bun: Bun + Node types, no DOM. Only type-checked.
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023"], "types": ["bun"], "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "allowImportingTsExtensions": true
  },
  "include": ["."]
}
