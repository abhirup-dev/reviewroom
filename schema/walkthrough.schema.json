{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\r\\n]*$"
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n]*$"
          },
          "lead": {
            "description": "Static for the whole chapter; may hold an <rr-flow> diagram",
            "type": "string"
          },
          "pr": {
            "description": "A stack of PRs: the PR this chapter is about (playing it shows that PR's layer). Omitted: about the whole stack (an intro, a hand-off)",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Narrative HTML: rr: links, <rr-flow>, <rr-code> work as in review.html"
                },
                "ref": {
                  "description": "What the right pane shows for this step: one link (its whole file, the lines highlighted), or several (each chunk stacked, across files). Omitted: keep the previous target (or the lead diagram)",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^rr:(code|file|sym|doc)\\/"
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^rr:(code|file|sym|doc)\\/"
                      }
                    }
                  ]
                }
              },
              "required": [
                "id",
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "steps"
        ]
      }
    },
    "stack": {
      "description": "Set by `walkthrough publish` on each PR's part of a stack's walkthrough: the stack, this PR's place in it (1 = bottom), and every chapter's id in order, so `reviewroom pr` chains the parts back",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "position": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "position",
        "order"
      ]
    }
  },
  "required": [
    "version",
    "title",
    "chapters"
  ],
  "$id": "reviewroom/walkthrough.schema.json",
  "title": "reviewroom guided walkthrough (walkthrough.json in the review dir)"
}
