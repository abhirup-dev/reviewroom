{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\r\\n]*$"
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n]*$"
          },
          "lead": {
            "description": "Static for the whole chapter; may hold an <rr-flow> diagram",
            "type": "string"
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Narrative HTML: rr: links, <rr-flow>, <rr-code> work as in review.html"
                },
                "ref": {
                  "description": "What the right pane shows for this step: one link (its whole file, the lines highlighted), or several (each chunk stacked, across files). Omitted: keep the previous target (the pane shows only code)",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^rr:(code|file|sym|doc)\\/"
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^rr:(code|file|sym|doc)\\/"
                      }
                    }
                  ]
                },
                "focus": {
                  "description": "Labels of the <rr-node>s that light up on this step, in the lead or the text. Omitted: nodes whose ref overlaps the code the pane shows; [] lights none",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "id",
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "steps"
        ]
      }
    }
  },
  "required": [
    "version",
    "title",
    "chapters"
  ],
  "$id": "reviewroom/walkthrough.schema.json",
  "title": "reviewroom guided walkthrough (walkthrough.json in the review dir)"
}
